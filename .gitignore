# Ignore everything inside the data directory
src-tauri/data/export/*
src-tauri/data/user/*
!src-tauri/data/user/placeholder

# Mod images are extracted from Warframe cache at runtime (140+ MB)
src-tauri/data/assets/card-images/
# Quest bounty card art extracted from Warframe cache (runtime data)
src-tauri/data/assets/ui/Lotus/

src-tauri/data/bin/*
!src-tauri/data/bin/*.png
!src-tauri/data/bin/pricer-models/
!src-tauri/data/bin/pricer-models/**


# Python cache in training pipeline

# Riven pricer training venv (created by tools/riven-pricer/retrain.py)
tools/riven-pricer/.venv/
__pycache__/
*.pyc
*.egg-info/

# Ignore target and Cargo.lock
src-tauri/target/
src-tauri/Cargo.lock

# C++ build artifacts
build_int/
build_int_win/
build_int_linux/
build_int_macos/

# Soup submodule content (git tracks it via .gitmodules, no need to index)
lib/soup/
*.obj

# Tauri v2 generated schemas (auto-generated, do not commit)
src-tauri/gen/

